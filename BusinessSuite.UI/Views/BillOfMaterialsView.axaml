<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BusinessSuite.UI.ViewModels"
             x:Class="BusinessSuite.UI.Views.BillOfMaterialsView"
             x:DataType="vm:BillOfMaterialsViewModel">

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="20,15">
            <Grid RowDefinitions="Auto,Auto">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBox Width="280" Watermark="Search finished product or material..." Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Classes="Primary" Content="Add BOM Line" Command="{Binding AddCommand}"/>
                    <Button Content="Edit" Command="{Binding EditCommand}" IsEnabled="{Binding !!SelectedBomLine}"/>
                    <Button Content="Remove" Command="{Binding DeleteCommand}" IsEnabled="{Binding !!SelectedBomLine}" Background="#EF4444" Foreground="White"/>
                    <Button Content="Refresh" Command="{Binding LoadCommand}"/>
                </StackPanel>
                <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Foreground="{Binding StatusMessageColor}" Margin="0,10,0,0"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <DataGrid ItemsSource="{Binding BomLines}" SelectedItem="{Binding SelectedBomLine}" IsReadOnly="True"
                      BorderBrush="#E5E7EB" BorderThickness="1" GridLinesVisibility="All">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Finished Product" Binding="{Binding FinishedProduct.ProductName}" Width="*"/>
                    <DataGridTextColumn Header="Raw Material" Binding="{Binding RawMaterialProduct.ProductName}" Width="*"/>
                    <DataGridTextColumn Header="Qty/Unit" Binding="{Binding Quantity, StringFormat=N2}" Width="90"/>
                    <DataGridTextColumn Header="UOM" Binding="{Binding UnitOfMeasure}" Width="70"/>
                    <DataGridTextColumn Header="Wastage %" Binding="{Binding WastagePercentage, StringFormat=N1}" Width="90"/>
                    <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" VerticalAlignment="Top"/>
        </Grid>
    </Grid>

    <UserControl.Styles>
        <Style Selector="Button.Primary">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Styles>
</UserControl>
