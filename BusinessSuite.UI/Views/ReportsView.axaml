<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BusinessSuite.UI.ViewModels"
             xmlns:Views="clr-namespace:BusinessSuite.UI.Views"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="BusinessSuite.UI.Views.ReportsView"
             x:DataType="vm:ReportsViewModel">

    <Grid RowDefinitions="Auto, *">
        <StackPanel Margin="30,30,30,10">
            <TextBlock Text="Reports &amp; Analytics" FontSize="24" FontWeight="Bold" Foreground="#111827"/>
            <TextBlock Text="Detailed insights into your business performance." Foreground="#6B7280" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- SelectedIndex bound so non-GST businesses land on Top Vendors (index 1) by default -->
        <TabControl Grid.Row="1" Margin="30,0,30,30" SelectedIndex="{Binding SelectedTabIndex}">

            <!-- Tab 0: GST Report — hidden for non-GST businesses -->
            <TabItem Header="GST Report" FontSize="16" IsVisible="{Binding IsGstRegistered}">
                <Grid RowDefinitions="Auto, *" Margin="0,20,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="15" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="From Date" FontSize="12" Foreground="#6B7280" Margin="0,0,0,5"/>
                            <DatePicker SelectedDate="{Binding StartDate}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="To Date" FontSize="12" Foreground="#6B7280" Margin="0,0,0,5"/>
                            <DatePicker SelectedDate="{Binding EndDate}"/>
                        </StackPanel>
                        <Button Content="Generate Report" Command="{Binding LoadReportsCommand}"
                                Background="#2563EB" Foreground="White" VerticalAlignment="Bottom"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="30" Width="500" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <StackPanel Spacing="20">
                            <TextBlock Text="GST Summary" FontSize="18" FontWeight="SemiBold"/>
                            <Separator Background="#E5E7EB" Height="1"/>

                            <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                                <TextBlock Text="Total Taxable Value" Grid.Row="0" Margin="0,10"/>
                                <TextBlock Text="{Binding GstReport.TaxableValue, StringFormat='{}₹{0:N2}'}" Grid.Row="0" Grid.Column="1" FontWeight="SemiBold"/>

                                <TextBlock Text="Output Tax (Collected)" Grid.Row="1" Margin="0,10"/>
                                <TextBlock Text="{Binding GstReport.OutputTaxAmount, StringFormat='{}₹{0:N2}'}" Grid.Row="1" Grid.Column="1" Foreground="#10B981" FontWeight="SemiBold"/>

                                <TextBlock Text="Input Tax (Paid)" Grid.Row="2" Margin="0,10"/>
                                <TextBlock Text="{Binding GstReport.InputTaxAmount, StringFormat='{}₹{0:N2}'}" Grid.Row="2" Grid.Column="1" Foreground="#EF4444" FontWeight="SemiBold"/>

                                <Separator Background="#E5E7EB" Height="1" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,10"/>
                            </Grid>

                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="Net Tax Liability" FontWeight="Bold" FontSize="16"/>
                                <TextBlock Text="{Binding GstReport.NetTaxLiability, StringFormat='{}₹{0:N2}'}" Grid.Column="1" FontWeight="Bold" FontSize="16"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 1: Top Vendors — always visible, default for non-GST -->
            <TabItem Header="Top Vendors" FontSize="16">
                <DataGrid ItemsSource="{Binding TopVendors}" Margin="0,20,0,0" IsReadOnly="True" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Vendor Name" Binding="{Binding VendorName}" Width="*"/>
                        <DataGridTextColumn Header="Purchase Volume" Binding="{Binding TotalPurchaseVolume, StringFormat='{}₹{0:N2}'}" Width="150"/>
                        <DataGridTextColumn Header="Orders" Binding="{Binding OrderCount}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Tab 2: Top Customers — always visible -->
            <TabItem Header="Top Customers" FontSize="16">
                <DataGrid ItemsSource="{Binding TopCustomers}" Margin="0,20,0,0" IsReadOnly="True" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Customer Name" Binding="{Binding CustomerName}" Width="*"/>
                        <DataGridTextColumn Header="Total Spent" Binding="{Binding TotalSpent, StringFormat='{}₹{0:N2}'}" Width="150"/>
                        <DataGridTextColumn Header="Orders" Binding="{Binding OrderCount}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Tab 3: GSTR-1 — hidden for non-GST -->
            <TabItem Header="GSTR-1" FontSize="16" IsVisible="{Binding IsGstRegistered}">
                <DataGrid ItemsSource="{Binding Gstr1Items}" Margin="0,20,0,0" IsReadOnly="True" GridLinesVisibility="All" BorderThickness="1" BorderBrush="#E5E7EB">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="100"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding InvoiceDate, StringFormat='{}dd/MM/yyyy'}" Width="90"/>
                        <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="150"/>
                        <DataGridTextColumn Header="GSTIN" Binding="{Binding CustomerGstin}" Width="120"/>
                        <DataGridTextColumn Header="State" Binding="{Binding CustomerState}" Width="80"/>
                        <DataGridTextColumn Header="HSN / SAC" Binding="{Binding HsnCode}" Width="80"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding ItemType}" Width="80"/>
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="60"/>
                        <DataGridTextColumn Header="Taxable Amt" Binding="{Binding TaxableAmount, StringFormat='{}₹{0:N2}'}" Width="120"/>
                        <DataGridTextColumn Header="Tax %" Binding="{Binding TaxRate, StringFormat={}{0:N0}%}" Width="70"/>
                        <DataGridTextColumn Header="CGST" Binding="{Binding CgstAmount, StringFormat='{}₹{0:N2}'}" Width="100"/>
                        <DataGridTextColumn Header="SGST" Binding="{Binding SgstAmount, StringFormat='{}₹{0:N2}'}" Width="100"/>
                        <DataGridTextColumn Header="IGST" Binding="{Binding IgstAmount, StringFormat='{}₹{0:N2}'}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Tab 4: GSTR-3B — hidden for non-GST -->
            <TabItem Header="GSTR-3B" FontSize="16" IsVisible="{Binding IsGstRegistered}">
                <DataGrid ItemsSource="{Binding Gstr3BItems}" Margin="0,20,0,0" IsReadOnly="True" GridLinesVisibility="All" BorderThickness="1" BorderBrush="#E5E7EB">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Customer Type" Binding="{Binding CustomerType}" Width="120"/>
                        <DataGridTextColumn Header="Tax Rate" Binding="{Binding TaxRate, StringFormat={}{0:N0}%}" Width="100"/>
                        <DataGridTextColumn Header="Transactions" Binding="{Binding TransactionCount}" Width="100"/>
                        <DataGridTextColumn Header="Taxable Amount" Binding="{Binding TaxableAmount, StringFormat='{}₹{0:N2}'}" Width="150"/>
                        <DataGridTextColumn Header="CGST" Binding="{Binding CgstAmount, StringFormat='{}₹{0:N2}'}" Width="120"/>
                        <DataGridTextColumn Header="SGST" Binding="{Binding SgstAmount, StringFormat='{}₹{0:N2}'}" Width="120"/>
                        <DataGridTextColumn Header="IGST" Binding="{Binding IgstAmount, StringFormat='{}₹{0:N2}'}" Width="120"/>
                        <DataGridTextColumn Header="Total Tax" Binding="{Binding TotalTaxAmount, StringFormat='{}₹{0:N2}'}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Tab 5: Tax Liability — hidden for non-GST -->
            <TabItem Header="Tax Liability" FontSize="16" IsVisible="{Binding IsGstRegistered}">
                <Grid RowDefinitions="Auto, *" Margin="20">
                    <StackPanel Orientation="Horizontal" Spacing="15" Margin="0,0,0,20">
                        <TextBlock Text="Period:" VerticalAlignment="Center" FontWeight="Medium"/>
                        <ComboBox ItemsSource="{Binding PeriodOptions}"
                                  SelectedItem="{Binding SelectedPeriod}"
                                  Width="120"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding TaxLiabilityItems}" IsReadOnly="True" GridLinesVisibility="All" BorderThickness="1" BorderBrush="#E5E7EB">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Period" Binding="{Binding Period}" Width="100"/>
                            <DataGridTextColumn Header="Sales" Binding="{Binding SalesCount}" Width="80"/>
                            <DataGridTextColumn Header="Sales Amount" Binding="{Binding SalesTaxableAmount, StringFormat='{}₹{0:N2}'}" Width="140"/>
                            <DataGridTextColumn Header="Purchases" Binding="{Binding PurchaseCount}" Width="100"/>
                            <DataGridTextColumn Header="Purchase Amount" Binding="{Binding PurchasesTaxableAmount, StringFormat='{}₹{0:N2}'}" Width="150"/>
                            <DataGridTextColumn Header="Outgoing CGST" Binding="{Binding OutgoingCgst, StringFormat='{}₹{0:N2}'}" Width="130"/>
                            <DataGridTextColumn Header="Outgoing SGST" Binding="{Binding OutgoingSgst, StringFormat='{}₹{0:N2}'}" Width="130"/>
                            <DataGridTextColumn Header="Outgoing IGST" Binding="{Binding OutgoingIgst, StringFormat='{}₹{0:N2}'}" Width="130"/>
                            <DataGridTextColumn Header="Incoming CGST" Binding="{Binding IncomingCgst, StringFormat='{}₹{0:N2}'}" Width="130"/>
                            <DataGridTextColumn Header="Incoming SGST" Binding="{Binding IncomingSgst, StringFormat='{}₹{0:N2}'}" Width="130"/>
                            <DataGridTextColumn Header="Incoming IGST" Binding="{Binding IncomingIgst, StringFormat='{}₹{0:N2}'}" Width="130"/>
                            <DataGridTextColumn Header="Net CGST" Binding="{Binding NetCgstPayable, StringFormat='{}₹{0:N2}'}" Width="120"/>
                            <DataGridTextColumn Header="Net SGST" Binding="{Binding NetSgstPayable, StringFormat='{}₹{0:N2}'}" Width="120"/>
                            <DataGridTextColumn Header="Net IGST" Binding="{Binding NetIgstPayable, StringFormat='{}₹{0:N2}'}" Width="120"/>
                            <DataGridTextColumn Header="Total Payable" Binding="{Binding TotalTaxPayable, StringFormat='{}₹{0:N2}'}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Tab 6: HSN Summary — hidden for non-GST -->
            <TabItem Header="HSN Summary" FontSize="16" IsVisible="{Binding IsGstRegistered}">
                <DataGrid ItemsSource="{Binding HsnSummaryItems}" Margin="0,20,0,0" IsReadOnly="True" GridLinesVisibility="All" BorderThickness="1" BorderBrush="#E5E7EB">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="HSN / SAC" Binding="{Binding HsnCode}" Width="100"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding ItemType}" Width="80"/>
                        <DataGridTextColumn Header="Tax Rate" Binding="{Binding TaxRate, StringFormat={}{0:N0}%}" Width="100"/>
                        <DataGridTextColumn Header="Qty" Binding="{Binding TotalQuantity}" Width="80"/>
                        <DataGridTextColumn Header="Taxable Amount" Binding="{Binding TaxableAmount, StringFormat='{}₹{0:N2}'}" Width="140"/>
                        <DataGridTextColumn Header="CGST Rate" Binding="{Binding CgstRate, StringFormat={}{0:N2}%}" Width="110"/>
                        <DataGridTextColumn Header="CGST Amount" Binding="{Binding CgstAmount, StringFormat='{}₹{0:N2}'}" Width="130"/>
                        <DataGridTextColumn Header="SGST Rate" Binding="{Binding SgstRate, StringFormat={}{0:N2}%}" Width="110"/>
                        <DataGridTextColumn Header="SGST Amount" Binding="{Binding SgstAmount, StringFormat='{}₹{0:N2}'}" Width="130"/>
                        <DataGridTextColumn Header="IGST Rate" Binding="{Binding IgstRate, StringFormat={}{0:N2}%}" Width="110"/>
                        <DataGridTextColumn Header="IGST Amount" Binding="{Binding IgstAmount, StringFormat='{}₹{0:N2}'}" Width="130"/>
                        <DataGridTextColumn Header="Total Tax" Binding="{Binding TotalTaxAmount, StringFormat='{}₹{0:N2}'}" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <Border Grid.RowSpan="2" Background="#88FFFFFF" IsVisible="{Binding IsLoading}">
            <ProgressBar IsIndeterminate="True" VerticalAlignment="Center" HorizontalAlignment="Center" Width="200"/>
        </Border>
    </Grid>
</UserControl>