<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BusinessSuite.UI.ViewModels"
             xmlns:Views="clr-namespace:BusinessSuite.UI.Views"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="BusinessSuite.UI.Views.ReportsView"
             x:DataType="vm:ReportsViewModel">

    <Grid RowDefinitions="Auto, *">
        <StackPanel Margin="30,30,30,10">
            <TextBlock Text="Reports &amp; Analytics" FontSize="24" FontWeight="Bold" Foreground="#111827"/>
            <TextBlock Text="Detailed insights into your business performance." Foreground="#6B7280" Margin="0,5,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1" Margin="30,0,30,30">
            <TabItem Header="GST Report" FontSize="16">
                <Grid RowDefinitions="Auto, *" Margin="0,20,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="15" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="From Date" FontSize="12" Foreground="#6B7280" Margin="0,0,0,5"/>
                            <DatePicker SelectedDate="{Binding StartDate}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="To Date" FontSize="12" Foreground="#6B7280" Margin="0,0,0,5"/>
                            <DatePicker SelectedDate="{Binding EndDate}"/>
                        </StackPanel>
                        <Button Content="Generate Report" Command="{Binding LoadReportsCommand}" 
                                Background="#2563EB" Foreground="White" VerticalAlignment="Bottom"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="30" Width="500" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <StackPanel Spacing="20">
                            <TextBlock Text="GST Summary" FontSize="18" FontWeight="SemiBold"/>
                            <Separator Background="#E5E7EB" Height="1"/>
                            
                            <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                                <TextBlock Text="Total Taxable Value" Grid.Row="0" Margin="0,10"/>
                                <TextBlock Text="{Binding GstReport.TaxableValue, StringFormat='{}₹{0:N2}'}" Grid.Row="0" Grid.Column="1" FontWeight="SemiBold"/>

                                <TextBlock Text="Output Tax (Collected)" Grid.Row="1" Margin="0,10"/>
                                <TextBlock Text="{Binding GstReport.OutputTaxAmount, StringFormat='{}₹{0:N2}'}" Grid.Row="1" Grid.Column="1" Foreground="#10B981" FontWeight="SemiBold"/>

                                <TextBlock Text="Input Tax (Paid)" Grid.Row="2" Margin="0,10"/>
                                <TextBlock Text="{Binding GstReport.InputTaxAmount, StringFormat='{}₹{0:N2}'}" Grid.Row="2" Grid.Column="1" Foreground="#EF4444" FontWeight="SemiBold"/>

                                <Separator Background="#E5E7EB" Height="1" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,10"/>
                            </Grid>
                            
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="Net Tax Liability" FontWeight="Bold" FontSize="16"/>
                                <TextBlock Text="{Binding GstReport.NetTaxLiability, StringFormat='{}₹{0:N2}'}" Grid.Column="1" FontWeight="Bold" FontSize="16"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Top Vendors" FontSize="16">
                <DataGrid ItemsSource="{Binding TopVendors}" Margin="0,20,0,0" IsReadOnly="True" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Vendor Name" Binding="{Binding VendorName}" Width="*"/>
                        <DataGridTextColumn Header="Purchase Volume" Binding="{Binding TotalPurchaseVolume, StringFormat='{}₹{0:N2}'}" Width="150"/>
                        <DataGridTextColumn Header="Orders" Binding="{Binding OrderCount}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Top Customers" FontSize="16">
                <DataGrid ItemsSource="{Binding TopCustomers}" Margin="0,20,0,0" IsReadOnly="True" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Customer Name" Binding="{Binding CustomerName}" Width="*"/>
                        <DataGridTextColumn Header="Total Spent" Binding="{Binding TotalSpent, StringFormat='{}₹{0:N2}'}" Width="150"/>
                        <DataGridTextColumn Header="Orders" Binding="{Binding OrderCount}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <Border Grid.RowSpan="2" Background="#88FFFFFF" IsVisible="{Binding IsLoading}">
            <ProgressBar IsIndeterminate="True" VerticalAlignment="Center" HorizontalAlignment="Center" Width="200"/>
        </Border>
    </Grid>
</UserControl>