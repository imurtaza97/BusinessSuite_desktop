<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BusinessSuite.UI.ViewModels"
             xmlns:conv="clr-namespace:BusinessSuite.UI.Converters"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="BusinessSuite.UI.Views.PurchaseOrderFormView"
             x:DataType="vm:PurchaseOrderFormViewModel"
             Name="Root">

    <UserControl.Resources>
        <conv:DecimalToBoolConverter x:Key="DecimalToBoolConverter"/>
        <conv:NullToZeroConverter x:Key="NullToZeroConverter"/>
    </UserControl.Resources>

    <ScrollViewer>
        <Grid RowDefinitions="Auto, *, Auto" Margin="30">
            <!-- Header Info -->
            <StackPanel Grid.Row="0" Spacing="20" Margin="0,0,0,20">
                <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" Foreground="#111827"/>
                
                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="20">
                    <Grid ColumnDefinitions="*, *, *">
                        <StackPanel Grid.Column="0" Spacing="5" Margin="0,0,10,0">
                            <TextBlock Text="Vendor" FontWeight="Medium" Foreground="#374151"/>
                            <Grid ColumnDefinitions="*, Auto">
                                <ComboBox ItemsSource="{Binding FilteredVendors}" 
                                          SelectedItem="{Binding SelectedVendor}"
                                          Text="{Binding VendorSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                          IsDropDownOpen="{Binding IsVendorDropDownOpen}"
                                          MaxDropDownHeight="300"
                                          HorizontalAlignment="Stretch"
                                          IsEditable="True"
                                          IsTextSearchEnabled="False"
                                          IsEnabled="{Binding CanEditCoreFields}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{Binding VendorName}"/>
                                                <TextBlock Text="{Binding ContactNo}" Foreground="Gray" FontSize="12"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="1" 
                                        Content="+" 
                                        Command="{Binding AddVendorCommand}"
                                        Padding="10,0"
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Stretch"
                                        VerticalContentAlignment="Center"
                                        Background="#F3F4F6"
                                        IsEnabled="{Binding CanEditCoreFields}"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="5" Margin="10,0,10,0">
                            <TextBlock Text="PO Number" FontWeight="Medium" Foreground="#374151"/>
                            <TextBox Text="{Binding PoNumber}" IsReadOnly="True" Background="#F9FAFB"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="5" Margin="10,0,0,0">
                            <TextBlock Text="Place of Supply" FontWeight="Medium" Foreground="#374151"/>
                            <ComboBox ItemsSource="{Binding ((vm:DashboardViewModel)DataContext).States, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding PlaceOfSupply}"
                                      HorizontalAlignment="Stretch"
                                      IsEnabled="{Binding CanEditCoreFields}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,10,0,0">
                    <Grid ColumnDefinitions="*, *, *, *, *, *">
                        <StackPanel Grid.Column="0" Spacing="5" Margin="0,0,10,0">
                            <TextBlock Text="Date" FontWeight="Medium" Foreground="#374151"/>
                            <CalendarDatePicker SelectedDate="{Binding PoDate}" HorizontalAlignment="Stretch" SelectedDateFormat="Short" IsEnabled="{Binding CanEditCoreFields}"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1" Spacing="5" Margin="10,0,10,0">
                            <TextBlock Text="Expected Delivery" FontWeight="Medium" Foreground="#374151"/>
                            <CalendarDatePicker SelectedDate="{Binding ExpectedDeliveryDate}" HorizontalAlignment="Stretch" SelectedDateFormat="Short" IsEnabled="{Binding CanEditCoreFields}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="5" Margin="10,0,10,0">
                            <TextBlock Text="Warehouse" FontWeight="Medium" Foreground="#374151"/>
                            <ComboBox ItemsSource="{Binding Warehouses}" 
                                      SelectedItem="{Binding SelectedWarehouse}" 
                                      HorizontalAlignment="Stretch"
                                      IsEnabled="{Binding CanEditCoreFields}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding WarehouseName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Spacing="5" Margin="10,0,10,0">
                            <TextBlock Text="Delivery" FontWeight="Medium" Foreground="#374151"/>
                            <ComboBox ItemsSource="{Binding DeliveryStatusOptions}" SelectedItem="{Binding DeliveryStatus}" HorizontalAlignment="Stretch" IsEnabled="{Binding CanEditDeliveryStatus}"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="4" Spacing="5" Margin="10,0,0,0">
                            <TextBlock Text="Payment" FontWeight="Medium" Foreground="#374151"/>
                            <ComboBox ItemsSource="{Binding PaymentStatusOptions}" SelectedItem="{Binding PaymentStatus}" HorizontalAlignment="Stretch" IsEnabled="{Binding CanEditPaymentStatus}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="5" Spacing="5" Margin="10,0,0,0">
                            <TextBlock Text="Reverse Charge" FontWeight="Medium" Foreground="#374151"/>
                            <ToggleSwitch OnContent="Yes" OffContent="No" IsChecked="{Binding ReverseCharge}" IsEnabled="{Binding CanEditCoreFields}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Discount Mode Toggle -->
                <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center" Margin="0,10">
                    <TextBlock Text="Discount Mode:" VerticalAlignment="Center" FontWeight="Medium"/>
                    <ToggleSwitch OnContent="Item-level" OffContent="Overall" IsChecked="{Binding IsItemLevelDiscount}" IsEnabled="{Binding CanEditCoreFields}"/>
                </StackPanel>
            </StackPanel>

            <!-- Line Items -->
            <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" MinHeight="300">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" 
                            Content="+ Add Item" 
                            Command="{Binding AddItemCommand}" 
                            Margin="20"
                            Classes="Secondary"
                            IsEnabled="{Binding CanEditItems}"/>
                    
                    <DataGrid ItemsSource="{Binding Items}" 
                              CanUserSortColumns="False" 
                              CanUserResizeColumns="True"
                              IsReadOnly="{Binding IsFinalized}"
                              GridLinesVisibility="All"
                              BorderThickness="0,0,0,1"
                              x:Name="POGrid">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Product" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*, Auto">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding SelectedProduct.ProductName}"
                                                           VerticalAlignment="Center"
                                                           Margin="4,0,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap"
                                                           HorizontalAlignment="Stretch"/>
                                                <TextBlock Text="{Binding SelectedProduct.Type, StringFormat='({0})'}"
                                                           Foreground="#6B7280"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" 
                                                    Content="+" 
                                                    Command="{Binding ((vm:PurchaseOrderFormViewModel)DataContext).AddProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Padding="5,0"
                                                    Margin="2,0"
                                                    Background="Transparent"
                                                    IsEnabled="{Binding DataContext.CanEditItems, ElementName=Root}"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*, Auto">
                                            <ComboBox ItemsSource="{Binding FilteredProducts}"
                                                      SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                                                      Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                                      IsDropDownOpen="{Binding IsDropDownOpen}"
                                                      MaxDropDownHeight="300"
                                                      HorizontalAlignment="Stretch"
                                                      BorderThickness="0"
                                                      IsTextSearchEnabled="False"
                                                      IsEditable="True"
                                                      IsEnabled="{Binding DataContext.CanEditItems, ElementName=Root}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                                            <TextBlock Text="{Binding ProductName}"/>
                                                            <TextBlock Text="{Binding Type, StringFormat='({0})'}" Foreground="#6B7280" FontSize="12"/>
                                                            <TextBlock Text="{Binding SKU}" Foreground="Gray" FontSize="12"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button Grid.Column="1" 
                                                    Content="+" 
                                                    Command="{Binding ((vm:PurchaseOrderFormViewModel)DataContext).AddProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Padding="5,0"
                                                    Margin="2,0"
                                                    Background="Transparent"
                                                    IsEnabled="{Binding DataContext.CanEditItems, ElementName=Root}"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Type" Binding="{Binding ProductType}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="HSN / SAC" Binding="{Binding HsnCode}" Width="100" IsVisible="{Binding ((vm:PurchaseOrderFormViewModel)DataContext).ShowGstFields, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <DataGridTemplateColumn Header="UOM" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding ((vm:PurchaseOrderFormViewModel)DataContext).UnitNames, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                  SelectedItem="{Binding Unit}"
                                                  HorizontalAlignment="Stretch"
                                                  BorderThickness="0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Quantity" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <NumericUpDown Value="{Binding Quantity, Converter={StaticResource NullToZeroConverter}}" Minimum="1" BorderThickness="0" ShowButtonSpinner="False"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Unit Price" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <NumericUpDown Value="{Binding UnitPrice, Converter={StaticResource NullToZeroConverter}}" Minimum="0" BorderThickness="0" ShowButtonSpinner="False"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Discount" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <NumericUpDown Value="{Binding Discount, Converter={StaticResource NullToZeroConverter}}" Minimum="0" BorderThickness="0" ShowButtonSpinner="False"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Tax %" Width="100" IsVisible="{Binding ((vm:PurchaseOrderFormViewModel)DataContext).ShowGstFields, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding TaxRates}" 
                                                  SelectedItem="{Binding TaxRate}" 
                                                  IsEnabled="{Binding IsTaxEditable}"
                                                  HorizontalAlignment="Stretch"
                                                  BorderThickness="0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Tax Amt" Binding="{Binding TaxAmount, StringFormat=₹ \{0:N2\}}" IsReadOnly="True" Width="100" IsVisible="{Binding ((vm:PurchaseOrderFormViewModel)DataContext).ShowGstFields, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat=₹ \{0:N2\}}" IsReadOnly="True" Width="120"/>

                            <DataGridTemplateColumn Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.RemoveItemCommand, ElementName=Root}" 
                                                CommandParameter="{Binding}"
                                                Content="✕" 
                                                Foreground="#EF4444" 
                                                Background="Transparent"
                                                HorizontalAlignment="Center"
                                                IsEnabled="{Binding DataContext.CanEditItems, ElementName=Root}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Bottom Section: Terms & Totals -->
            <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="0,20,0,0">
                <!-- Left: Payment/Terms -->
                <StackPanel Grid.Column="0" Spacing="15" Margin="0,0,30,0">
                    <Grid ColumnDefinitions="*, *">
                        <StackPanel Grid.Column="0" Spacing="5" Margin="0,0,10,0">
                            <TextBlock Text="Payment Method" FontWeight="Medium"/>
                            <ComboBox ItemsSource="{Binding PaymentMethodsList}" 
                                      SelectedItem="{Binding PaymentMethod}" 
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5" Margin="10,0,0,0">
                            <TextBlock Text="Payment Terms" FontWeight="Medium"/>
                            <TextBox Text="{Binding PaymentTerms}"/>
                        </StackPanel>
                    </Grid>
                    
                    <StackPanel Spacing="10" Margin="0,0,0,10">
                        <TextBlock Text="Vendor Bill Attachment (Optional)" FontWeight="Medium"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="Attach Bill (PDF/Image)" Click="OnAttachBillClicked" Background="#F3F4F6"/>
                            <TextBlock Text="{Binding VendorBillFileName}" VerticalAlignment="Center" Foreground="#2563EB" 
                                       IsVisible="{Binding VendorBillFileName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <Button Content="✕" Click="OnClearBillClicked" Foreground="#EF4444" Background="Transparent" 
                                       IsVisible="{Binding VendorBillFileName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="5">
                        <TextBlock Text="Notes" FontWeight="Medium"/>
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60" Watermark="Add internal notes..."/>
                    </StackPanel>

                    <StackPanel Spacing="5">
                        <TextBlock Text="Terms and Conditions" FontWeight="Medium"/>
                        <TextBox Text="{Binding TermsAndConditions, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60" Watermark="Add terms for vendor..."/>
                    </StackPanel>

                    <TextBlock Text="{Binding GeneralErrorMessage}" Foreground="#EF4444" IsVisible="{Binding ValidationVisible}"/>
                </StackPanel>
 
                <!-- Right: Totals -->
                <StackPanel Grid.Column="1" Spacing="10" Width="300">
                    <Grid ColumnDefinitions="*, Auto" Margin="0,5" IsVisible="{Binding ShowGstFields}">
                        <TextBlock Text="Taxable Amount:"/>
                        <TextBlock Grid.Column="1" Text="{Binding TotalAmount, StringFormat=₹ \{0:N2\}}" FontWeight="SemiBold"/>
                    </Grid>

                    <Separator Margin="0,5" IsVisible="{Binding ShowGstFields}"/>
                    
                    <StackPanel IsVisible="{Binding ShowGstFields}">
                        <StackPanel IsVisible="{Binding TotalCGST, Converter={StaticResource DecimalToBoolConverter}}">
                            <TextBlock Text="Tax Type: CGST + SGST" FontSize="11" Foreground="#3B82F6" Margin="0,2"/>
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="CGST:" FontWeight="Medium"/>
                                <TextBlock Grid.Column="1" Text="{Binding TotalCGST, StringFormat=₹ \{0:N2\}}" FontWeight="SemiBold"/>
                            </Grid>
                            <Grid ColumnDefinitions="*, Auto" Margin="0,2,0,5">
                                <TextBlock Text="SGST:" FontWeight="Medium"/>
                                <TextBlock Grid.Column="1" Text="{Binding TotalSGST, StringFormat=₹ \{0:N2\}}" FontWeight="SemiBold"/>
                            </Grid>
                        </StackPanel>
                        
                        <StackPanel IsVisible="{Binding TotalIGST, Converter={StaticResource DecimalToBoolConverter}}">
                            <TextBlock Text="Tax Type: IGST" FontSize="11" Foreground="#3B82F6" Margin="0,2"/>
                            <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,5">
                                <TextBlock Text="IGST:" FontWeight="Medium"/>
                                <TextBlock Grid.Column="1" Text="{Binding TotalIGST, StringFormat=₹ \{0:N2\}}" FontWeight="SemiBold"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <Grid ColumnDefinitions="*, Auto" Margin="0,5" IsVisible="{Binding ShowGstFields}">
                        <TextBlock Text="Total Tax:" FontWeight="Medium"/>
                        <TextBlock Grid.Column="1" Text="{Binding TotalTax, StringFormat=₹ \{0:N2\}}" FontWeight="SemiBold"/>
                    </Grid>
                    <Separator Margin="0,5" IsVisible="{Binding ShowGstFields}"/>

                    <Grid ColumnDefinitions="*, Auto" Margin="0,5">
                        <TextBlock Text="Discount:"/>
                        <NumericUpDown Grid.Column="1" Value="{Binding Discount, Converter={StaticResource NullToZeroConverter}}" Width="120" ShowButtonSpinner="False" IsEnabled="{Binding CanEditDiscountAmount}"/>
                    </Grid>
                    
                    <Grid ColumnDefinitions="*, Auto" Margin="0,5">
                        <TextBlock Text="Shipping Charges:"/>
                        <NumericUpDown Grid.Column="1" Value="{Binding ShippingCharges, Converter={StaticResource NullToZeroConverter}}" Width="120" ShowButtonSpinner="False" IsEnabled="{Binding CanEditCoreFields}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" Margin="0,5">
                        <TextBlock Text="Round Off:"/>
                        <StackPanel Orientation="Horizontal" Spacing="10" Grid.Column="1" VerticalAlignment="Center">
                            <CheckBox Content="Round off" IsChecked="{Binding IsAutoRoundOff}" VerticalAlignment="Center" IsEnabled="{Binding CanEditCoreFields}"/>
                            <TextBlock Text="{Binding RoundOff, StringFormat=₹ \{0:N2\}}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#6B7280"/>
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto" Margin="0,5">
                        <TextBlock Text="Total Paid:" FontWeight="Bold" VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Column="1" Value="{Binding TotalPaid, Converter={StaticResource NullToZeroConverter}}" Width="120" ShowButtonSpinner="False" Foreground="#059669" FontWeight="Bold" IsEnabled="{Binding CanEditCoreFields}"/>
                    </Grid>
                    <Separator/>
                    <Grid ColumnDefinitions="*, Auto" Margin="0,10">
                        <TextBlock Text="Grand Total:" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Text="{Binding GrandTotal, StringFormat=₹ \{0:N2\}}" FontSize="18" FontWeight="Bold" Foreground="#2563EB"/>
                    </Grid>
 
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,20,25,0">
                        <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="80" HorizontalContentAlignment="Center"/>
                        <Button Content="Save as Draft" Command="{Binding SaveDraftCommand}" MinWidth="95" HorizontalContentAlignment="Center" Classes="Secondary" IsEnabled="{Binding CanEditCoreFields}"/>
                        <Button Content="Save PO" Command="{Binding SaveCommand}" MinWidth="95" HorizontalContentAlignment="Center" Classes="Primary"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>

    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.Primary">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style Selector="Button.Secondary">
            <Setter Property="Background" Value="#DBEAFE"/>
            <Setter Property="Foreground" Value="#1D4ED8"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style Selector="Button.Secondary:pointerover">
            <Setter Property="Background" Value="#BFDBFE"/>
        </Style>
        <Style Selector="Button.Secondary:pressed">
            <Setter Property="Background" Value="#93C5FD"/>
        </Style>
    </UserControl.Styles>
</UserControl>
