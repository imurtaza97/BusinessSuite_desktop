<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BusinessSuite.UI.ViewModels"
        x:Class="BusinessSuite.UI.Views.InvoiceExportOptionsWindow"
        x:DataType="vm:InvoiceExportOptionsViewModel"
        Title="Invoice Export Options"
        Width="400" Height="250"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#F9FAFB">

    <StackPanel Margin="30" Spacing="20" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="What would you like to do?" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
        <TextBlock Text="Choose an action for this invoice." Foreground="#6B7280" HorizontalAlignment="Center"/>
        
        <StackPanel Orientation="Horizontal" Spacing="15" HorizontalAlignment="Center">
            <Button Command="{Binding ChooseDownloadCommand}" Background="#2563EB" Foreground="White" Width="100" Height="80">
                <StackPanel Spacing="5">
                    <TextBlock Text="📥" FontSize="24" HorizontalAlignment="Center"/>
                    <TextBlock Text="Download" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            
            <Button Command="{Binding ChoosePrintCommand}" Background="#10B981" Foreground="White" Width="100" Height="80">
                <StackPanel Spacing="5">
                    <TextBlock Text="🖨️" FontSize="24" HorizontalAlignment="Center"/>
                    <TextBlock Text="Print" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            
            <Button Command="{Binding ChooseBothCommand}" Background="#7C3AED" Foreground="White" Width="100" Height="80">
                <StackPanel Spacing="5">
                    <TextBlock Text="✨" FontSize="24" HorizontalAlignment="Center"/>
                    <TextBlock Text="Both" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <Button Content="Cancel" Command="{Binding CancelCommand}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
    </StackPanel>
</Window>
