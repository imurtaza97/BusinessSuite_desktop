<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BusinessSuite.UI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="500"
        x:Class="BusinessSuite.UI.Views.PaymentFormWindow"
        x:DataType="vm:PaymentFormViewModel"
        Title="{Binding Title}"
        Width="400" Height="500"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#F9FAFB">

    <Grid RowDefinitions="Auto, *, Auto" Margin="25">
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="{Binding Title}" 
                       FontSize="20" 
                       FontWeight="Bold" 
                       Foreground="#111827" />
            
            <Border Background="#FEE2E2" 
                    BorderBrush="#EF4444" 
                    BorderThickness="1" 
                    CornerRadius="4" 
                    Padding="10" 
                    Margin="0,15,0,0"
                    IsVisible="{Binding GeneralErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding GeneralErrorMessage}" 
                           Foreground="#B91C1C" 
                           FontSize="12"
                           TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- Form Fields -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="15">
                <StackPanel>
                    <TextBlock Text="Amount *" Margin="0,0,0,5" FontWeight="Medium" Foreground="#374151"/>
                    <NumericUpDown Value="{Binding Amount}" Minimum="0" FormatString="0.00" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Payment Date" Margin="0,0,0,5" FontWeight="Medium" Foreground="#374151"/>
                    <CalendarDatePicker SelectedDate="{Binding PaymentDate}" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Payment Method" Margin="0,0,0,5" FontWeight="Medium" Foreground="#374151"/>
                    <ComboBox ItemsSource="{Binding PaymentMethods}" 
                              SelectedItem="{Binding PaymentMethod}"
                              HorizontalAlignment="Stretch"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Reference (Cheque/Transaction ID)" Margin="0,0,0,5" FontWeight="Medium" Foreground="#374151"/>
                    <TextBox Text="{Binding Reference}" Watermark="e.g. TRN123456"/>
                </StackPanel>

                <StackPanel Spacing="5">
                    <TextBlock Text="Notes" FontWeight="Medium" Foreground="#374151"/>
                    <TextBox Text="{Binding Notes}" AcceptsReturn="True" Height="80" Watermark="Add optional notes..."/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,20,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" Width="100" HorizontalContentAlignment="Center"/>
            <Button Content="Save Payment" 
                    Command="{Binding SaveCommand}" 
                    Width="140" 
                    HorizontalContentAlignment="Center" 
                    Background="#2563EB" 
                    Foreground="White" 
                    FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
