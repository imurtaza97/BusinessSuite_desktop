<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:conv="clr-namespace:BusinessSuite.UI.Converters"
             xmlns:vm="using:BusinessSuite.UI.ViewModels"
             xmlns:models="using:BusinessSuite.DAL.Entities"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="800"
             x:Class="BusinessSuite.UI.Views.HomeView"
             x:DataType="vm:HomeViewModel">

    <UserControl.Resources>
        <conv:StatusColorConverter x:Key="StatusColorConverter"/>
    </UserControl.Resources>

    <ScrollViewer Background="#F8F9FA">
        <StackPanel Margin="30" Spacing="25">
            <!-- Quick Links -->
            <StackPanel Orientation="Horizontal" Spacing="15" Margin="0,0,0,10">
                <Button Command="{Binding NavigateToLedgerCommand}" Classes="QuickLink">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="📄" VerticalAlignment="Center"/>
                        <TextBlock Text="Finance Ledger" VerticalAlignment="Center" FontWeight="Medium"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding NavigateToStockLedgerCommand}" Classes="QuickLink">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="📦" VerticalAlignment="Center"/>
                        <TextBlock Text="Stock Ledger" VerticalAlignment="Center" FontWeight="Medium"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Stats Section -->
            <UniformGrid Columns="4" Rows="1">
                <Border Classes="StatCard">
                    <StackPanel>
                        <TextBlock Text="Total Sales" Classes="StatLabel"/>
                        <TextBlock Text="{Binding TotalSales, StringFormat='{}₹{0:N2}'}" Classes="StatValue"/>
                        <!-- <TextBlock Text="+12% from last month" Classes="StatTrend Positive"/> -->
                    </StackPanel>
                </Border>
                <Border Classes="StatCard">
                    <StackPanel>
                        <TextBlock Text="Net Profit" Classes="StatLabel"/>
                        <TextBlock Text="{Binding NetProfit, StringFormat='{}₹{0:N2}'}" Classes="StatValue"/>
                        <!-- <TextBlock Text="+5.2% from last month" Classes="StatTrend Positive"/> -->
                    </StackPanel>
                </Border>
                <Border Classes="StatCard">
                    <StackPanel>
                        <TextBlock Text="Active Orders" Classes="StatLabel"/>
                        <TextBlock Text="{Binding ActiveOrders}" Classes="StatValue"/>
                        <TextBlock Text="Unpaid invoices" Classes="StatTrend Negative"/>
                    </StackPanel>
                </Border>
                <Border Classes="StatCard">
                    <StackPanel>
                        <TextBlock Text="Receivables" Classes="StatLabel"/>
                        <TextBlock Text="{Binding TotalReceivable, StringFormat='{}₹{0:N2}'}" Classes="StatValue"/>
                        <TextBlock Text="Pending payment" Classes="StatTrend Negative"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Sales Trend Chart -->
            <Border Background="White" CornerRadius="12" BoxShadow="0 4 15 0 #0A000000" Padding="20">
                <StackPanel>
                    <TextBlock Text="Sales Trend (Current Year)" FontSize="16" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,15"/>
                    <lvc:CartesianChart Series="{Binding SalesTrendSeries}" XAxes="{Binding XAxes}" Height="250"/>
                </StackPanel>
            </Border>

            <!-- Recent Activity Section -->
            <Border Background="White" CornerRadius="12" BoxShadow="0 4 15 0 #0A000000" Padding="25">
                <StackPanel Spacing="20">
                    <TextBlock Text="Recent Transactions" FontSize="18" FontWeight="SemiBold" Foreground="#333333"/>
                    <Separator Background="#EEEEEE" Height="1"/>
                    <Grid ColumnDefinitions="*, *, *, *, *">
                        <TextBlock Grid.Column="0" Text="Invoice #" FontWeight="Medium" Foreground="#666666"/>
                        <TextBlock Grid.Column="1" Text="Customer" FontWeight="Medium" Foreground="#666666"/>
                        <TextBlock Grid.Column="2" Text="Date" FontWeight="Medium" Foreground="#666666"/>
                        <TextBlock Grid.Column="3" Text="Amount" FontWeight="Medium" Foreground="#666666"/>
                        <TextBlock Grid.Column="4" Text="Status" FontWeight="Medium" Foreground="#666666"/>
                    </Grid>
                    
                    <ItemsControl ItemsSource="{Binding RecentActivity}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:Invoice">
                            <Grid ColumnDefinitions="*, *, *, *, *" Margin="0,5">
                                <TextBlock Grid.Column="0" Text="{Binding InvoiceNumber}" Foreground="#333333"/>
                                <TextBlock Grid.Column="1" Text="{Binding Customer.CustomerName}" Foreground="#333333"/>
                                <TextBlock Grid.Column="2" Text="{Binding InvoiceDate, StringFormat='{}{0:MMM dd, yyyy}'}" Foreground="#333333"/>
                                <TextBlock Grid.Column="3" Text="{Binding GrandTotal, StringFormat='{}₹{0:N2}'}" Foreground="#333333" FontWeight="Bold"/>
                                <StackPanel Grid.Column="4" Spacing="4" VerticalAlignment="Center" Orientation="Horizontal">
                                    <Border Background="{Binding PaymentStatus, Converter={StaticResource StatusColorConverter}}" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{Binding PaymentStatus}" FontSize="10" Foreground="Black"/>
                                    </Border>
                                    <Border Background="{Binding DeliveryStatus, Converter={StaticResource StatusColorConverter}}" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{Binding DeliveryStatus}" FontSize="10" Foreground="Black"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

    <UserControl.Styles>
        <Style Selector="Border.StatCard">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="BoxShadow" Value="0 4 15 0 #0A000000"/>
        </Style>
        <Style Selector="TextBlock.StatLabel">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style Selector="TextBlock.StatValue">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style Selector="TextBlock.StatTrend">
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style Selector="TextBlock.Positive">
            <Setter Property="Foreground" Value="#10B981"/>
        </Style>
        <Style Selector="TextBlock.Negative">
            <Setter Property="Foreground" Value="#EF4444"/>
        </Style>

        <Style Selector="Button.QuickLink">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Button.QuickLink:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
        </Style>
    </UserControl.Styles>
</UserControl>
