<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BusinessSuite.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="BusinessSuite.UI.Views.ProductsView"
             x:DataType="vm:ProductsViewModel">

    <Grid RowDefinitions="Auto, *">
        <!-- Header Actions -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="20,15">
            <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="15">
                    <TextBox Width="250" 
                             Watermark="Search products..." 
                             Text="{Binding SearchQuery}"/>
                    <ComboBox Width="150"
                              ItemsSource="{Binding ProductTypes}"
                              SelectedItem="{Binding SelectedProductType}"
                              PlaceholderText="All Types"/>
                    <ComboBox Width="150"
                              ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory}"
                              PlaceholderText="All Categories"/>
                    <Button Content="x" 
                            Command="{Binding ClearCategoryFilterCommand}" 
                            IsVisible="{Binding SelectedCategory, Converter={x:Static ObjectConverters.IsNotNull}}"
                            ToolTip.Tip="Clear Category Filter"
                            Padding="8,4"
                            VerticalAlignment="Center"/>
                    <Button Classes="Primary" Content="Add Item" Command="{Binding AddProductCommand}"/>
                </StackPanel>
                
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button Content="Edit" Command="{Binding EditProductCommand}" IsEnabled="{Binding !!SelectedProduct}" />
                    <Button Classes="Danger" Content="Delete" Command="{Binding DeleteProductCommand}" />
                    <Button Content="Refresh" Command="{Binding LoadProductsCommand}"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding StatusMessage}"
                           Foreground="{Binding StatusMessageColor}"
                           FontSize="12"
                           Margin="0,12,0,0"/>
            </Grid>
        </Border>

        <!-- Product Content -->
        <Grid Grid.Row="1" ColumnDefinitions="*, 350" Margin="20">
            <!-- Product List -->
            <Grid Grid.Column="0" RowDefinitions="*, Auto">
                <DataGrid Grid.Row="0" ItemsSource="{Binding Products}" 
                          SelectedItem="{Binding SelectedProduct}"
                          SelectionChanged="DataGrid_SelectionChanged"
                          SelectionMode="Extended"
                          IsReadOnly="False" 
                          CanUserReorderColumns="True"
                          CanUserResizeColumns="True"
                          BorderThickness="1"
                          BorderBrush="#E5E7EB"
                          GridLinesVisibility="All">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category.Name}" Width="150" IsReadOnly="True"/>
                        <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Stock" Binding="{Binding StockQty}" Width="80" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Sale Price" Binding="{Binding SalePrice, StringFormat='{}₹{0:N2}'}" Width="110" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
                
                <!-- Pagination for Products -->
                <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1,0,1,1" Padding="10,5">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                        <Button Content="&lt;" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding HasPreviousPage}" Padding="5,2"/>
                        <TextBlock Text="{Binding CurrentPage}" FontWeight="Bold" VerticalAlignment="Center" FontSize="12"/>
                        <TextBlock Text="/" VerticalAlignment="Center" FontSize="12"/>
                        <TextBlock Text="{Binding TotalPages}" VerticalAlignment="Center" FontSize="12"/>
                        <Button Content="&gt;" Command="{Binding NextPageCommand}" IsEnabled="{Binding HasNextPage}" Padding="5,2"/>
                    </StackPanel>
                </Border>
                
                <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" VerticalAlignment="Top"/>
            </Grid>

            <!-- Stock Distribution Panel -->
            <Border Grid.Column="1" Margin="15,0,0,0" Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1">
                <Grid RowDefinitions="Auto, *">
                    <Border Grid.Row="0" Padding="15" Background="#F9FAFB" CornerRadius="8,8,0,0" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Stock Distribution" FontSize="14" FontWeight="Bold" Foreground="#374151"/>
                            <TextBlock Text="{Binding SelectedProduct.ProductName}" FontSize="12" Foreground="#6B7280" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,5,0,0">
                                <TextBlock Text="Total:" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SelectedProduct.StockQty}" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedProductWarehouseStock}" IsReadOnly="True" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Warehouse" Binding="{Binding Warehouse.WarehouseName}" Width="*"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
    
    <UserControl.Styles>
        <Style Selector="Button.Primary">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.Danger">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Styles>
</UserControl>
