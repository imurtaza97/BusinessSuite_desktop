<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BusinessSuite.UI.ViewModels"
             xmlns:conv="clr-namespace:BusinessSuite.UI.Converters"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="BusinessSuite.UI.Views.QuotationsView"
             x:DataType="vm:QuotationsViewModel">

    <Grid RowDefinitions="Auto, *, Auto">
        <!-- Header Actions -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="20,15">
            <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="15">
                    <TextBox Width="300" 
                             Watermark="Search quotations by number or customer..." 
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Classes="Primary" Content="Create New Quotation" Command="{Binding AddQuotationCommand}"/>
                    <Button Content="Edit" Command="{Binding EditQuotationCommand}" IsEnabled="{Binding !!SelectedQuotation}"/>
                    <Button Content="Delete" Command="{Binding DeleteQuotationCommand}" IsEnabled="{Binding !!SelectedQuotation}" Background="#EF4444" Foreground="White"/>
                    <Button Content="Download/Print"
                            Command="{Binding PrintQuotationCommand}"
                            IsEnabled="{Binding !!SelectedQuotation}"
                            Background="#10B981" Foreground="White"/>
                    <Button Content="Convert to Invoice"
                            Command="{Binding ConvertToInvoiceCommand}"
                            IsEnabled="{Binding !!SelectedQuotation}"
                            Background="#2563EB" Foreground="White"
                            ToolTip.Tip="Generate a draft invoice from this quotation"/>
                </StackPanel>
                
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button Content="Refresh" Command="{Binding RefreshCommand}"/>
                </StackPanel>
                
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding StatusMessage}" Foreground="{Binding StatusMessageColor}" Margin="0,10,0,0"/>
            </Grid>
        </Border>

        <!-- Quotation List -->
        <Grid Grid.Row="1" Margin="20">
            <DataGrid ItemsSource="{Binding Quotations}" 
                      SelectedItem="{Binding SelectedQuotation}"
                      IsReadOnly="True" 
                      CanUserReorderColumns="True"
                      CanUserResizeColumns="True"
                      BorderThickness="1"
                      BorderBrush="#E5E7EB"
                      GridLinesVisibility="All">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Doc Number" Binding="{Binding QuotationNumber}" Width="120"/>
                    <DataGridTemplateColumn Header="Status" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding IsDraft, Converter={x:Static conv:SafeDisplayConverter.Instance}, ConverterParameter='DRAFT|FINALIZED'}"
                                           Background="{Binding IsDraft, Converter={x:Static conv:SafeDisplayConverter.Instance}, ConverterParameter='#FEE2E2|#E0E7FF'}"
                                           Foreground="{Binding IsDraft, Converter={x:Static conv:SafeDisplayConverter.Instance}, ConverterParameter='#DC2626|#4F46E5'}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Padding="8,4"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Date" Binding="{Binding QuotationDate, Converter={x:Static conv:SafeDisplayConverter.Instance}, ConverterParameter=\{0:dd/MM/yyyy\}}" Width="120"/>
                    <DataGridTextColumn Header="Customer" Binding="{Binding Customer, Converter={x:Static conv:SafeDisplayConverter.Instance}, ConverterParameter=Customer}" Width="*"/>
                    <DataGridTextColumn Header="Amount" Binding="{Binding TotalAmount, Converter={x:Static conv:SafeDisplayConverter.Instance}, ConverterParameter='₹ {0:N2}'}" Width="120"/>
                    <DataGridTextColumn Header="Tax" Binding="{Binding TotalTax, Converter={x:Static conv:SafeDisplayConverter.Instance}, ConverterParameter='₹ {0:N2}'}" Width="120"/>
                    <DataGridTextColumn Header="Grand Total" Binding="{Binding GrandTotal, Converter={x:Static conv:SafeDisplayConverter.Instance}, ConverterParameter='₹ {0:N2}'}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
            
            <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" VerticalAlignment="Top"/>
        </Grid>

        <!-- Pagination -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="20,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20">
                <Button Content="Previous" 
                        Command="{Binding PreviousPageCommand}" 
                        IsEnabled="{Binding HasPreviousPage}"/>
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="5">
                    <TextBlock Text="Page" VerticalAlignment="Center" Foreground="#6B7280"/>
                    <TextBlock Text="{Binding CurrentPage}" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="of" VerticalAlignment="Center" Foreground="#6B7280"/>
                    <TextBlock Text="{Binding TotalPages}" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalCount, StringFormat='({0} total)'}" FontSize="12" VerticalAlignment="Center" Foreground="#9CA3AF" Margin="5,0,0,0"/>
                </StackPanel>

                <Button Content="Next" 
                        Command="{Binding NextPageCommand}" 
                        IsEnabled="{Binding HasNextPage}"/>
            </StackPanel>
        </Border>
    </Grid>

    <UserControl.Styles>
        <Style Selector="Button.Primary">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Styles>
</UserControl>
