<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BusinessSuite.UI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="700"
        x:Class="BusinessSuite.UI.Views.ProductFormWindow"
        x:DataType="vm:ProductFormViewModel"
        Title="{Binding Title}"
        Width="450" Height="700"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#F9FAFB">

    <Grid RowDefinitions="Auto, *, Auto" Margin="25">
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{Binding Title}" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Foreground="#111827" />
            
            <Border Background="#FEE2E2" 
                    BorderBrush="#EF4444" 
                    BorderThickness="1" 
                    CornerRadius="4" 
                    Padding="10" 
                    Margin="0,15,0,0"
                    IsVisible="{Binding GeneralErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding GeneralErrorMessage}" 
                           Foreground="#B91C1C" 
                           FontSize="12"
                           TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="15">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <ToggleSwitch IsChecked="{Binding IsService}" OnContent="Service" OffContent="Product" Width="140"/>
                    <TextBlock Text="Item Type" VerticalAlignment="Center" FontWeight="Medium" Foreground="#374151"/>
                </StackPanel>

                <TextBlock Text="Choose Product for stock-managed items; select Service for billable services." 
                           Foreground="#4B5563" FontSize="11" Margin="0,0,0,5" TextWrapping="Wrap"/>

                <Border Background="#EFF6FF" CornerRadius="6" Padding="10" IsVisible="{Binding IsService}">
                    <TextBlock Text="Services do not use stock data. Only cost and fee are required." 
                               Foreground="#1D4ED8" FontSize="12" TextWrapping="Wrap" />
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" IsVisible="{Binding IsService}">
                    <ToggleSwitch IsChecked="{Binding !IsInternalService}" OnContent="External" OffContent="Internal" Width="140"/>
                    <TextBlock Text="Service Provider" VerticalAlignment="Center" FontWeight="Medium" Foreground="#374151"/>
                </StackPanel>

                <Border Background="#FEF3C7" CornerRadius="6" Padding="10" IsVisible="{Binding IsInternalService}">
                    <TextBlock Text="Internal service provided by your business. No need to add provider or cost." 
                               Foreground="#92400E" FontSize="12" TextWrapping="Wrap" />
                </Border>

                <StackPanel>
                    <TextBlock Text="Name *" Margin="0,0,0,5" FontWeight="Medium" Foreground="#374151"/>
                    <TextBox Text="{Binding ProductName}" Watermark="Enter item name"/>
                </StackPanel>

                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto">
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                        <TextBlock Text="{Binding SkuLabel}" Margin="0,0,0,5" FontWeight="Medium" Foreground="#374151"/>
                        <TextBox Text="{Binding ProductSku}" Watermark="{Binding SkuWatermark}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="{Binding CodeLabel}" Margin="0,0,0,5" FontWeight="Medium" Foreground="#374151"/>
                        <TextBox Text="{Binding ProductHsnCode}" Watermark="{Binding CodeWatermark}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,10">
                        <TextBlock Text="Unit *" Margin="0,0,0,5" FontWeight="Medium" Foreground="#374151"/>
                        <ComboBox ItemsSource="{Binding UnitNames}" 
                                  SelectedItem="{Binding Unit}"
                                  HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="{Binding CategoryLabel}" Margin="0,0,0,5" FontWeight="Medium" Foreground="#374151"/>
                        <Grid ColumnDefinitions="*, Auto">
                            <ComboBox ItemsSource="{Binding Categories}" 
                                      SelectedItem="{Binding SelectedCategory}"
                                      PlaceholderText="Select"
                                      HorizontalAlignment="Stretch"/>
                            <Button Grid.Column="1" Content="+" Command="{Binding AddCategoryCommand}" Margin="5,0,0,0"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,10">
                         <TextBox Text="{Binding NewCategoryName}" Watermark="Enter new category name if adding..." IsVisible="True"/> 
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,10,10" IsVisible="{Binding ShowVendorAndCost}">
                        <TextBlock Text="{Binding PreferredVendorLabel}" Margin="0,0,0,5" FontWeight="Medium" Foreground="#374151"/>
                        <ComboBox ItemsSource="{Binding Vendors}" 
                                  SelectedItem="{Binding SelectedPreferredVendor}"
                                  PlaceholderText="Select vendor"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding VendorName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    
                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="Tax Rate (GST %) *" Margin="0,0,0,5" FontWeight="Medium" Foreground="#374151"/>
                        <ComboBox ItemsSource="{Binding AvailableTaxRates}" 
                                  SelectedItem="{Binding TaxRate}"
                                  HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,10,10" IsVisible="{Binding ShowVendorAndCost}">
                        <TextBlock Text="{Binding PurchasePriceLabel}" Margin="0,0,0,5" FontWeight="Medium" Foreground="#374151"/>
                        <NumericUpDown Value="{Binding PurchasePrice}" Minimum="0" FormatString="0.00"/>
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="{Binding SalePriceLabel}" Margin="0,0,0,5" FontWeight="Medium" Foreground="#374151"/>
                        <NumericUpDown Value="{Binding SalePrice}" Minimum="0" FormatString="0.00"/>
                    </StackPanel>

                    <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,0,10,0" IsVisible="{Binding IsProduct}">
                        <TextBlock Text="Initial Stock" Margin="0,0,0,5" FontWeight="Medium" Foreground="#374151"/>
                        <NumericUpDown Value="{Binding StockQty}" Minimum="0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,0,0,0" IsVisible="{Binding IsProduct}">
                        <TextBlock Text="Warehouse" Margin="0,0,0,5" FontWeight="Medium" Foreground="#374151"/>
                        <ComboBox ItemsSource="{Binding Warehouses}" 
                                  SelectedItem="{Binding SelectedWarehouse}"
                                  PlaceholderText="Select"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding WarehouseName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,20,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="80"/>
            <Button Content="Save as Draft" Command="{Binding SaveDraftCommand}" Classes="Secondary"/>
            <Button Content="{Binding SaveButtonText}" 
                    Command="{Binding SaveCommand}" 
                    MinWidth="110" 
                    Background="#2563EB" 
                    Foreground="White" 
                    FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.Secondary">
            <Setter Property="Background" Value="#DBEAFE"/>
            <Setter Property="Foreground" Value="#1D4ED8"/>
        </Style>
    </Window.Styles>
</Window>