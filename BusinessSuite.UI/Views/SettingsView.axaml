<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BusinessSuite.UI.ViewModels"
             xmlns:conv="clr-namespace:BusinessSuite.UI.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="BusinessSuite.UI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Grid ColumnDefinitions="250, *">
        <!-- Sidebar Navigation -->
        <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,20">
                <TextBlock Text="Settings" FontSize="20" FontWeight="Bold" Margin="20,0,20,20" Foreground="#111827"/>
                
                <ListBox ItemsSource="{Binding SettingsSections}"
                         SelectedItem="{Binding SelectedSection}" 
                         Background="Transparent" BorderThickness="0">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="20,12"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#F3F4F6"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="#EFF6FF"/>
                            <Setter Property="TextBlock.Foreground" Value="#2563EB"/>
                            <Setter Property="TextBlock.FontWeight" Value="SemiBold"/>
                        </Style>
                    </ListBox.Styles>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" RowDefinitions="*, Auto">
            <ScrollViewer Grid.Row="0">
                <StackPanel Margin="40" Spacing="25">
                    <!-- Status Message -->
                    <Border IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Background="#DCFCE7" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="4" Padding="12">
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#166534" FontSize="14"/>
                    </Border>

                    <!-- ════════════════════════════════════════════════════ -->
                    <!-- PROFILE SECTION                                      -->
                    <!-- ════════════════════════════════════════════════════ -->
                    <StackPanel Spacing="20" IsVisible="{Binding SelectedSection, Converter={x:Static conv:StringEqualityConverter.Instance}, ConverterParameter=Profile}">
                        <TextBlock Text="Business Profile" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="Update your business identity and contact details." Foreground="#6B7280"/>
                        
                        <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="25">
                            <StackPanel Spacing="15">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Business Name" FontWeight="Medium"/>
                                    <TextBox Text="{Binding BusinessName}"/>
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Email" FontWeight="Medium"/>
                                    <TextBox Text="{Binding Email}" Watermark="e.g. info@yourbusiness.com"/>
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Contact No" FontWeight="Medium"/>
                                    <TextBox Text="{Binding ContactNo}" Watermark="e.g. +91-9876543210"/>
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Address" FontWeight="Medium"/>
                                    <TextBox Text="{Binding Address}" AcceptsReturn="True" Height="80"/>
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="State" FontWeight="Medium"/>
                                    <ComboBox ItemsSource="{Binding States}"
                                              SelectedItem="{Binding State}"
                                              HorizontalAlignment="Stretch"/>
                                </StackPanel>

                                <!-- PAN Number -->
                                <StackPanel Spacing="5">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock Text="PAN (Permanent Account Number)" FontWeight="Medium" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="#F3F4F6" CornerRadius="12" Padding="8,3">
                                            <TextBlock Text="{Binding PanValidationIcon}"
                                                       Foreground="{Binding PanValidationColor}"
                                                       FontWeight="Bold" FontSize="13"/>
                                        </Border>
                                    </Grid>
                                    <TextBox Text="{Binding Pan, UpdateSourceTrigger=PropertyChanged}"
                                             Watermark="e.g. ABCDE1234F (optional)"
                                             MaxLength="10"/>
                                    <TextBlock Text="{Binding PanError}"
                                               Foreground="#DC2626"
                                               FontSize="11"
                                               IsVisible="{Binding PanError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <TextBlock Text="Format: 5 letters + 4 digits + 1 letter  |  Required for IT filings"
                                               Foreground="#9CA3AF" FontSize="11"
                                               IsVisible="{Binding PanError, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ════════════════════════════════════════════════════ -->
                    <!-- TAX & GST SECTION                                    -->
                    <!-- ════════════════════════════════════════════════════ -->
                    <StackPanel Spacing="20" IsVisible="{Binding SelectedSection, Converter={x:Static conv:StringEqualityConverter.Instance}, ConverterParameter='Tax &amp; GST'}">
                        <TextBlock Text="Tax &amp; GST Settings" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="Configure your tax registration details." Foreground="#6B7280"/>
                        
                        <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="25">
                            <StackPanel Spacing="20">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <CheckBox IsChecked="{Binding IsGstRegistered}"/>
                                    <TextBlock Text="I am registered for GST" VerticalAlignment="Center" FontWeight="Medium"/>
                                </StackPanel>

                                <StackPanel Spacing="15" IsVisible="{Binding IsGstRegistered}">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="GSTIN" FontWeight="Medium"/>
                                        <TextBox Text="{Binding Gstin}" Watermark="15-digit GST Number"/>
                                    </StackPanel>
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="GST Type" FontWeight="Medium"/>
                                        <ComboBox ItemsSource="{Binding GstTypesList}"
                                                  SelectedItem="{Binding GstType}"
                                                  HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </StackPanel>

                                <Border IsVisible="{Binding !IsGstRegistered}" Background="#F3F4F6" Padding="15" CornerRadius="4">
                                    <TextBlock Text="You are in Non-GST mode. GST fields will be hidden on invoices." 
                                               FontStyle="Italic" Foreground="#4B5563" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ════════════════════════════════════════════════════ -->
                    <!-- BANK DETAILS SECTION                                 -->
                    <!-- ════════════════════════════════════════════════════ -->
                    <StackPanel Spacing="20" IsVisible="{Binding SelectedSection, Converter={x:Static conv:StringEqualityConverter.Instance}, ConverterParameter='Bank Details'}">
                        <TextBlock Text="Bank Account Details" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="These details will be printed on your invoices for payments." Foreground="#6B7280"/>
                        
                        <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="25">
                            <StackPanel Spacing="15">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Bank Name" FontWeight="Medium"/>
                                    <TextBox Text="{Binding BankName}" Watermark="e.g. HDFC Bank"/>
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Account Name" FontWeight="Medium"/>
                                    <TextBox Text="{Binding AccountName}" Watermark="Enter account name"/>
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Account Number" FontWeight="Medium"/>
                                    <TextBox Text="{Binding AccountNumber}" Watermark="Enter account number"/>
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="IFSC Code" FontWeight="Medium"/>
                                    <TextBox Text="{Binding Ifsc}" Watermark="e.g. HDFC0001234"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ════════════════════════════════════════════════════ -->
                    <!-- FINANCIAL YEAR SECTION                               -->
                    <!-- ════════════════════════════════════════════════════ -->
                    <StackPanel Spacing="20" IsVisible="{Binding SelectedSection, Converter={x:Static conv:StringEqualityConverter.Instance}, ConverterParameter='Financial Year'}">
                        <TextBlock Text="Financial Year Management" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="Create, activate, and close your accounting financial years (Indian fiscal: Apr – Mar)." Foreground="#6B7280"/>

                        <!-- Active FY banner -->
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="16"
                                IsVisible="{Binding ActiveFY, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Border Background="#2563EB" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="ACTIVE" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding ActiveFY.Label}" FontSize="16" FontWeight="Bold" Foreground="#1D4ED8"/>
                                    <TextBlock Text="{Binding ActiveFY.PeriodLabel}" FontSize="12" Foreground="#3B82F6"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- FY Status Messages -->
                        <Border Background="#DCFCE7" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="6" Padding="12"
                                IsVisible="{Binding FyStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding FyStatusMessage}" Foreground="#166534" TextWrapping="Wrap"/>
                        </Border>

                        <!-- FY List -->
                        <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="0">
                            <StackPanel>
                                <!-- Header row -->
                                <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="15,10">
                                    <Grid ColumnDefinitions="*, 200, 120, Auto">
                                        <TextBlock Grid.Column="0" Text="Financial Year" FontWeight="SemiBold" Foreground="#374151" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="Period" FontWeight="SemiBold" Foreground="#374151" FontSize="12"/>
                                        <TextBlock Grid.Column="2" Text="Status" FontWeight="SemiBold" Foreground="#374151" FontSize="12"/>
                                        <TextBlock Grid.Column="3" Text="Actions" FontWeight="SemiBold" Foreground="#374151" FontSize="12" MinWidth="160"/>
                                    </Grid>
                                </Border>

                                <!-- FY Rows -->
                                <ItemsControl ItemsSource="{Binding FinancialYears}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="15,12">
                                                <Grid ColumnDefinitions="*, 200, 120, Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                                               Foreground="{Binding IsClosed, Converter={x:Static conv:BoolToColorConverter.Instance}, ConverterParameter='#9CA3AF|#111827'}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding PeriodLabel}"
                                                               FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="2" CornerRadius="10" Padding="8,3" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                            Background="{Binding IsClosed, Converter={x:Static conv:BoolToColorConverter.Instance}, ConverterParameter='#FEE2E2|#DCFCE7'}">
                                                        <TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="Medium"
                                                                   Foreground="{Binding IsClosed, Converter={x:Static conv:BoolToColorConverter.Instance}, ConverterParameter='#B91C1C|#166534'}"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                                                        <Button Content="Set Active"
                                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).SetActiveFYCommand}"
                                                                CommandParameter="{Binding}"
                                                                IsVisible="{Binding IsClosed, Converter={x:Static BoolConverters.Not}}"
                                                                IsEnabled="{Binding IsActive, Converter={x:Static BoolConverters.Not}}"
                                                                Padding="8,4" FontSize="11"
                                                                Background="#2563EB" Foreground="White"/>
                                                        <Button Content="Close Year"
                                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).RequestCloseFYCommand}"
                                                                CommandParameter="{Binding}"
                                                                IsVisible="{Binding IsClosed, Converter={x:Static BoolConverters.Not}}"
                                                                Padding="8,4" FontSize="11"
                                                                Background="#EF4444" Foreground="White"/>
                                                        <Border Background="#F3F4F6" CornerRadius="4" Padding="8,4"
                                                                IsVisible="{Binding IsClosed}">
                                                            <TextBlock Text="🔒 Closed" FontSize="11" Foreground="#6B7280"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Empty state -->
                                <Border Padding="30" IsVisible="{Binding !FinancialYears.Count}">
                                    <TextBlock Text="No financial years created yet. Create your first financial year below."
                                               HorizontalAlignment="Center" Foreground="#9CA3AF" FontStyle="Italic"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- + New FY button -->
                        <Button Content="+ Create New Financial Year"
                                Command="{Binding ShowNewFYFormCommandCommand}"
                                IsVisible="{Binding !ShowNewFYForm}"
                                Classes="Primary" HorizontalAlignment="Left" Padding="15,10"/>

                        <!-- New FY inline form -->
                        <Border Background="White" BorderBrush="#2563EB" BorderThickness="1" CornerRadius="8" Padding="20"
                                IsVisible="{Binding ShowNewFYForm}">
                            <StackPanel Spacing="15">
                                <TextBlock Text="Create New Financial Year" FontSize="16" FontWeight="Bold" Foreground="#1D4ED8"/>
                                <TextBlock Text="{Binding NewFYLabel}" FontSize="18" FontWeight="Bold" Foreground="#2563EB"
                                           IsVisible="{Binding NewFYLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                                <Grid ColumnDefinitions="*, 20, *">
                                    <StackPanel Grid.Column="0" Spacing="5">
                                        <TextBlock Text="Start Date" FontWeight="Medium" FontSize="13"/>
                                        <DatePicker SelectedDate="{Binding NewFYStart}" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="5">
                                        <TextBlock Text="End Date" FontWeight="Medium" FontSize="13"/>
                                        <DatePicker SelectedDate="{Binding NewFYEnd}" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{Binding FyStatusMessage}" Foreground="#EF4444" FontSize="12"
                                           IsVisible="{Binding FyStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="✓ Create Financial Year"
                                            Command="{Binding CreateFinancialYearCommand}"
                                            Classes="Primary" Padding="15,10"/>
                                    <Button Content="Cancel"
                                            Command="{Binding CancelNewFYCommand}"
                                            Padding="15,10"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Close Year Confirm Dialog -->
                        <Border Background="#FFF7ED" BorderBrush="#F59E0B" BorderThickness="2" CornerRadius="8" Padding="20"
                                IsVisible="{Binding ShowCloseDialog}">
                            <StackPanel Spacing="15">
                                <TextBlock Text="⚠ Close Financial Year" FontSize="16" FontWeight="Bold" Foreground="#92400E"/>
                                <TextBlock Text="{Binding FyToClose.Label, StringFormat='You are about to close {0}. This action cannot be undone.'}"
                                           TextWrapping="Wrap" Foreground="#78350F"/>

                                <StackPanel Spacing="8">
                                    <TextBlock Text="Carry closing balance forward to:" FontWeight="Medium" Foreground="#374151"/>
                                    <ComboBox ItemsSource="{Binding OpenFinancialYears}"
                                              SelectedItem="{Binding SelectedNextFY}"
                                              HorizontalAlignment="Stretch"
                                              PlaceholderText="Select next FY (optional)">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="Leave blank to close without carry-forward (you can do it later)."
                                               Foreground="#9CA3AF" FontSize="11"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Confirm Close Year"
                                            Command="{Binding ConfirmCloseYearCommand}"
                                            Background="#EF4444" Foreground="White" Padding="15,10"/>
                                    <Button Content="Cancel"
                                            Command="{Binding CancelCloseFYCommand}"
                                            Padding="15,10"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ════════════════════════════════════════════════════ -->
                    <!-- UNITS OF MEASURE SECTION                             -->
                    <!-- ════════════════════════════════════════════════════ -->
                    <StackPanel Spacing="20" IsVisible="{Binding SelectedSection, Converter={x:Static conv:StringEqualityConverter.Instance}, ConverterParameter='Units of Measure'}">
                        <TextBlock Text="Units of Measure" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="Manage the units used for your products (e.g. PCS, BOX, KG)." Foreground="#6B7280"/>
                        
                        <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="25">
                            <StackPanel Spacing="15">
                                <Grid ColumnDefinitions="*, Auto">
                                        <TextBox Text="{Binding NewUnitName}" Watermark="New unit name..." 
                                             KeyUp="Unit_KeyUp"/>
                                        <Button Grid.Column="1" Content="Add Unit" Command="{Binding AddUnitCommand}" 
                                            Margin="10,0,0,0" Classes="Primary"/>
                                </Grid>

                                <ListBox ItemsSource="{Binding Units}" Height="300" BorderThickness="1" BorderBrush="#E5E7EB">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*, Auto">
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="Delete" 
                                                    Command="{Binding ((vm:SettingsViewModel)DataContext).RemoveUnitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Classes="Danger"
                                                    IsVisible="{Binding BusinessId, Converter={x:Static conv:DecimalToBoolConverter.Instance}, ConverterParameter=0}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ════════════════════════════════════════════════════ -->
                    <!-- DATA MANAGEMENT SECTION                              -->
                    <!-- ════════════════════════════════════════════════════ -->
                    <StackPanel Spacing="20" IsVisible="{Binding SelectedSection, Converter={x:Static conv:StringEqualityConverter.Instance}, ConverterParameter='Data Management'}">
                        <TextBlock Text="Data Management" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="Backup your data to a secure location or restore from a previous backup." Foreground="#6B7280"/>
                        
                        <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="25">
                            <StackPanel Spacing="20">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Backup Database" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="Export your entire database (including products, invoices, and settings) to a file." 
                                               Foreground="#6B7280" FontSize="13" TextWrapping="Wrap"/>
                                    <Button Content="Create Backup Now" Click="OnBackupClicked" 
                                            Classes="Primary" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                </StackPanel>

                                <Separator Background="#E5E7EB"/>

                                <StackPanel Spacing="10">
                                    <TextBlock Text="Restore Database" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="Warning: Restoring will overwrite all current data. This action cannot be undone." 
                                               Foreground="#EF4444" FontSize="13" FontWeight="Medium" TextWrapping="Wrap"/>
                                    <Button Content="Select Backup to Restore" Click="OnRestoreClicked"
                                            BorderBrush="#EF4444" Foreground="#EF4444" BorderThickness="1"
                                            Background="Transparent" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8" Padding="15">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Data="{StaticResource WarningIcon}" Foreground="#D97706" Width="20"/>
                                <TextBlock Text="Tip: We recommend taking weekly backups and storing them on a separate drive or cloud storage." 
                                           Foreground="#92400E" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Action Bar -->
            <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="20">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Text="Tip: Don't forget to save after making changes." VerticalAlignment="Center" Foreground="#6B7280" FontSize="13"/>
                    <Button Grid.Column="1" Content="Save All Changes" 
                            Command="{Binding SaveCommand}"
                            Classes="Primary" Padding="30,12"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>

    <UserControl.Styles>
        <Style Selector="Button.Primary">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.Danger">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EF4444"/>
            <Setter Property="BorderBrush" Value="#EF4444"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Styles>
</UserControl>
